# ── Supabase ──
SUPABASE_PROJECT_ID=tu-project-id
SUPABASE_PUBLISHABLE_KEY=tu-publishable-key
SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_PROJECT_ID=tu-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=tu-publishable-key
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# ── URL pública del sitio (OBLIGATORIO para Mercado Pago y push) ──
PUBLIC_SITE_URL=https://tudominio.com

# ── Mercado Pago ──
MERCADOPAGO_ACCESS_TOKEN=tu-access-token
MERCADOPAGO_WEBHOOK_SECRET=tu-webhook-secret

# ── EmailJS (correos de estado) ──
EMAILJS_SERVICE_ID=tu-service-id
EMAILJS_TEMPLATE_ID=tu-template-id
EMAILJS_PUBLIC_KEY=tu-public-key

# ── VAPID (notificaciones push) ──
VITE_VAPID_PUBLIC_KEY=tu-vapid-public-key
VAPID_PRIVATE_KEY=tu-vapid-private-key

# ── PIX (clave de cobro, visible al cliente) ──
VITE_PIX_KEY=tu-pix-key

# ── Proveedor de recargas (opcional, пока no conectado) ──
RECHARGE_PROVIDER_API_URL=
RECHARGE_PROVIDER_API_KEY_NAME=RECHARGE_PROVIDER_API_KEY
