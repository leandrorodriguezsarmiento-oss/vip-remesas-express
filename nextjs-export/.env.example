# === Supabase (crea tu proyecto en supabase.com y pega estos valores) ===
# Todas las variables NEXT_PUBLIC_* se envían al navegador — seguro solo para
# la anon key y URL. La SERVICE_ROLE_KEY NUNCA lleva prefijo NEXT_PUBLIC_.

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# SECRETO — solo disponible en route handlers (/app/api/**) y server components.
# Se usa para: crear transactions/recargas con precios recalculados server-side,
# marcar pagos como recibidos, y borrar usuarios desde el panel admin.
# Sin esto, la app da "permission denied" al crear remesas o recargas.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# === Correo del admin owner (el único que verá el panel Admin) ===
ADMIN_EMAIL=leandrorodriguezsarmiento@gmail.com

# === URL pública de tu app en producción (para reset-password, OAuth callback) ===
NEXT_PUBLIC_SITE_URL=https://vipremesas.com
